// Force deploy trigger 1
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : {};
    }

    function isAdmin() {
      return isSignedIn() && getUserData().get('isAdmin', false) == true;
    }

    function isInsAdmin() {
      return isSignedIn() && getUserData().get('isinsadmin', false) == true;
    }

    // FIX VULN-05: isInsAdminFor already scopes to same institute — used consistently below.
    function isInsAdminFor(instituteId) {
      return isInsAdmin() && getUserData().get('instituteId', '') == instituteId;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow get: if isSignedIn();
      // Allow unauthenticated list with limit(1) for phone-based login lookup.
      // request.query.limit is checked as a belt-and-suspenders guard.
      allow list: if isSignedIn() || request.query.limit <= 1;
      // FIX PRIV-ESC: owners (and institute admins) may create their own profile but must NOT
      // self-provision elevated roles. Only a super admin can mint an admin account.
      allow create: if isAdmin()
                    || (isSignedIn() && isOwner(userId)
                        && request.resource.data.get('isAdmin', false) == false
                        && request.resource.data.get('isinsadmin', false) == false
                        && request.resource.data.get('isSuspended', false) == false)
                    || (isInsAdminFor(request.resource.data.get('instituteId', ''))
                        && request.resource.data.get('isAdmin', false) == false);
      allow delete: if isAdmin()
                    || isInsAdminFor(resource.data.get('instituteId', ''))
                    || (isSignedIn() && isOwner(userId));

      // FIX PRIV-ESC: field-scoped updates.
      //  • super admin: full control.
      //  • institute admin: may moderate their own institute's users but NOT grant admin roles.
      //  • owner: may edit own profile but NOT elevate privileges or lift their own suspension.
      //  • any signed-in user: may only touch connection/request arrays on another user (the connect
      //    flow) — never fcmTokens/liveLocation (owner-only; blocks push-token hijack & location spoof).
      allow update: if isAdmin()
                    || (isInsAdminFor(resource.data.get('instituteId', ''))
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['isAdmin', 'isinsadmin']))
                    || (isSignedIn() && isOwner(userId)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                             .hasAny(['isAdmin', 'isinsadmin', 'isSuspended']))
                    || (isSignedIn() && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['connections', 'pendingRequests', 'sentRequests']));
    }

    // ── Posts ─────────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if isSignedIn();

      // FIX VULN-03: Author must set their own UID. Prevents impersonation.
      allow create: if isSignedIn()
                    && request.resource.data.authorUid == request.auth.uid;

      // FIX VULN-03: Author can edit their own post. Any signed-in user can
      // update ONLY the 'likes' or 'comments' fields (for interactions).
      // Admins can edit anything.
      allow update: if isAdmin()
                    || isInsAdminFor(resource.data.get('instituteId', ''))
                    || (isSignedIn() && resource.data.authorUid == request.auth.uid)
                    || (isSignedIn() && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['likes', 'comments']));

      allow delete: if isAdmin()
                    || isInsAdminFor(resource.data.get('instituteId', ''))
                    || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    // ── Opportunities (Jobs board) ────────────────────────────────────────────
    match /opportunities/{oppId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    || isAdmin()
                    || isInsAdminFor(request.resource.data.get('instituteId', ''));
      allow update: if isAdmin()
                    || isInsAdminFor(resource.data.get('instituteId', ''))
                    || isInsAdminFor(request.resource.data.get('instituteId', ''))
                    || (isSignedIn() && resource.data.postedByUid == request.auth.uid);
      allow delete: if isAdmin()
                    || isInsAdminFor(resource.data.get('instituteId', ''))
                    || (isSignedIn() && resource.data.postedByUid == request.auth.uid);
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // ── Chats ─────────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn()
                 && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn();
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participants;
    }

    // ── Groups ────────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn()
                 && (resource == null || request.auth.uid in resource.data.members);
      allow create: if isSignedIn();
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.members;
    }

    // ── Subcollections (Messages) ─────────────────────────────────────────────
    // FIX INFO-01: Only chat participants can read/write messages.
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if isSignedIn()
                         && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // FIX INFO-02: Only group members can read/write messages.
    match /groups/{groupId}/messages/{messageId} {
      allow read, write: if isSignedIn()
                         && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    match /communityChat/{messageId} {
      allow read, create: if isSignedIn();
    }

    // ── Events ───────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() || isAdmin() || isInsAdminFor(request.resource.data.get('instituteId', ''));
      allow update, delete: if isAdmin()
                            || isInsAdminFor(resource.data.get('instituteId', ''))
                            || (isSignedIn() && resource.data.createdByUid == request.auth.uid);
    }

    // ── Institutes ────────────────────────────────────────────────────────────
    // FIX VULN-01: Unauthenticated users could read entire collection.
    // 'get' (single doc) is still allowed unauthenticated for the signup approval flow.
    // 'list' (queries) now requires a signed-in user.
    match /institutes/{instId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow write: if isAdmin() || isInsAdminFor(instId);
    }

    // ── Lobby Posts (Cross-Institute) ─────────────────────────────────────────
    match /lobbyPosts/{postId} {
      allow read, create: if isSignedIn();
      // FIX: only the author or an admin may edit post structure (title/content/isPinned);
      // everyone else may only react/comment/vote — not rewrite someone else's post.
      allow update: if isAdmin() || isInsAdmin()
                    || (isSignedIn() && resource.data.authorUid == request.auth.uid)
                    || (isSignedIn() && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['likes', 'comments', 'poll']));
      allow delete: if isAdmin() || isInsAdmin()
                    || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    // ── Email Approvals ───────────────────────────────────────────────────────
    // FIX VULN-02: Unauthenticated users could read the entire email approval list.
    // 'get' (single doc lookup) is still allowed unauthenticated for the signup flow
    // so new users can verify their email before they have an account.
    // 'list' (full collection scan) now requires a signed-in user.
    match /approvals/{email} {
      allow get: if true;
      // Allow unauthenticated list with limit(1) for phone-based signup/login lookup.
      allow list: if isSignedIn() || request.query.limit <= 1;
      allow write: if isAdmin() || isInsAdmin();
    }
  }
}
